#usda 1.0
(
    customLayerData = {
        string author = "Chloe Jin"
        string project = "Adaptive Neuro-Symbiosis Digital Twin (ANS-DT)"
        string units = "meters, Z up, 24 fps"
    }
    defaultPrim = "World"
    doc = "ANS-DT human-robot collaboration demo. A worker reaches into a shared bin while a robot arm transfers a part. The cognitive twin publishes an intent state and the robotic twin scales its speed. Intent, confidence and fusion weights are scripted stand-ins for model output."
    endTimeCode = 312
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 24
    upAxis = "Z"
)

